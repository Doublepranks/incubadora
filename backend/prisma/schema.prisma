generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  instagram
  x
  youtube
  kwai
  tiktok
}

enum SyncStatus {
  success
  error
}

enum LogType {
  system
  activity
}

enum LogLevel {
  info
  warn
  error
  debug
}

enum Series {
  Elite
  A2
  A3
  Institucional
  Cortes
  Noticias
}

enum GoalType {
  followers
  posts
}

enum GoalStatus {
  active
  achieved
  failed
  cancelled
}

enum Sex {
  masculino
  feminino
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  regions       UserRegion[]
  createdNotes  InfluencerNote[]
  logs          LogEntry[]
  createdGoals  InfluencerGoal[]
  refreshTokens RefreshToken[]
  @@index([role])
}

model Influencer {
  id              Int              @id @default(autoincrement())
  name            String
  avatarUrl       String?          @map("avatar_url")
  state           String
  city            String
  notes           String?
  series          Series?
  sex             Sex?
  socialProfiles  SocialProfile[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  notesHistory    InfluencerNote[]
  goals           InfluencerGoal[]

  @@index([state])
  @@index([city])
  @@index([series])
}

model InfluencerNote {
  id           Int        @id @default(autoincrement())
  content      String
  createdAt    DateTime   @default(now()) @map("created_at")
  
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId Int        @map("influencer_id")
  
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       Int?       @map("user_id")

  @@index([influencerId])
}

model SocialProfile {
  id             Int          @id @default(autoincrement())
  influencerId   Int          @map("influencer_id")
  platform       Platform
  handle         String
  url            String?
  externalId     String?      @map("external_id")
  metrics        MetricDaily[]
  createdAt      DateTime     @default(now()) @map("created_at")
  influencer     Influencer   @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  syncLogs       SyncLog[]

  @@index([influencerId])
}

model MetricDaily {
  id              Int       @id @default(autoincrement())
  socialProfileId Int       @map("social_profile_id")
  date            DateTime
  followersCount  Int       @map("followers_count")
  postsCount      Int       @map("posts_count")
  createdAt       DateTime  @default(now()) @map("created_at")

  socialProfile   SocialProfile @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)

  @@unique([socialProfileId, date])
  @@index([socialProfileId, date])
}

model SyncLog {
  id              Int          @id @default(autoincrement())
  socialProfileId Int?         @map("social_profile_id")
  startedAt       DateTime     @default(now()) @map("started_at")
  finishedAt      DateTime?    @map("finished_at")
  status          SyncStatus
  errorMessage    String?      @map("error_message")

  socialProfile   SocialProfile? @relation(fields: [socialProfileId], references: [id], onDelete: SetNull)

  @@index([socialProfileId])
}

model UserRegion {
  id     Int    @id @default(autoincrement())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int    @map("user_id")
  uf     String @db.Char(2)

  @@unique([userId, uf])
  @@index([userId])
}

model LogEntry {
  id        Int       @id @default(autoincrement())
  type      LogType
  level     LogLevel  @default(info)
  message   String
  meta      Json?
  userId    Int?      @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId])
}

model InfluencerGoal {
  id             Int         @id @default(autoincrement())
  influencerId   Int         @map("influencer_id")
  type           GoalType
  status         GoalStatus  @default(active)
  
  // Meta específica
  targetValue    Int         @map("target_value")
  platform       Platform?
  
  // Prazo
  deadline       DateTime
  
  // Rastreamento
  initialValue   Int?        @map("initial_value")
  currentValue   Int?        @map("current_value")
  achievedAt     DateTime?   @map("achieved_at")
  
  // Metadados
  description    String?
  createdBy      Int         @map("created_by")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  
  influencer     Influencer  @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  creator        User        @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  
  @@index([influencerId])
  @@index([status])
  @@index([deadline])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent")
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}
